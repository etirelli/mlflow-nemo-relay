# Copy to .env and adjust. Every value has a working default in the Makefile / compose.yaml.
# The Makefile reads this file and passes the agent settings to `openshell sandbox create --env`.

# --- LLM ----------------------------------------------------------------------
# Choose with `make up LLM=ollama|scripted|nvidia` (default: ollama).
#
# ollama: native Ollama on the laptop. Inside the sandbox the laptop is
# host.openshell.internal, and openshell/policy.yaml allows only
# POST /v1/chat/completions (and GET /v1/models) on port 11434.
LLM_BASE_URL=http://host.openshell.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=not-needed

# nvidia: build.nvidia.com through an OpenShell provider. Do NOT put the key in
# this file; export NVIDIA_API_KEY in your shell, run `make provider-nvidia`
# once, then `make up LLM=nvidia`. The sandbox only ever sees a placeholder.
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Any other OpenAI-compatible endpoint: set LLM_BASE_URL/LLM_MODEL above AND add
# a matching rule to openshell/policy.yaml (or a provider profile), otherwise
# the sandbox denies the connection - which is the point.

# --- Credentials (demo only, change for shared environments) ----------------
MLFLOW_ADMIN_PASSWORD=mlflow-admin-demo-password
MLFLOW_SECRET_KEY=uc1-demo-secret-key-change-me
AGENT_MLFLOW_USERNAME=relay-agent
AGENT_MLFLOW_PASSWORD=relay-agent-demo-password

# --- Ports / behavior ------------------------------------------------------
MLFLOW_PORT=5000
REDACTED_AGENT_PORT=8000
BASELINE_AGENT_PORT=8001
TOOL_TIMEOUT_SECONDS=2.0

# --- OpenShell ---------------------------------------------------------------
# Container engine of the OpenShell gateway (docker | podman). Auto-detected.
# ENGINE=docker
# REDACTED_SANDBOX=uc1-agent-redacted
# BASELINE_SANDBOX=uc1-agent-baseline
