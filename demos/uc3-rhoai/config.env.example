# Local, cluster-specific configuration for the UC3 OpenShift AI demo.
# Copy to config.env (gitignored) and edit. Values become OpenShift Template parameters.
#   cp config.env.example config.env

# Namespace (project) for the demo. It is also the MLflow workspace.
NAMESPACE=uc3-rhoai

# LLM: any OpenAI-compatible endpoint that supports tool calling. The agents and the
# evaluation's LLM judge both use it.
# LLM_MODEL must match an id from GET $LLM_BASE_URL/models.
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=my-model-id

# Name of an existing Secret in NAMESPACE that holds the API key, and the key inside it.
# Create it yourself (the key never goes in this file):
#   read -rs "K?API key: "; oc create secret generic llm-credentials -n $NAMESPACE --from-literal=api-key="$K"; unset K
LLM_API_KEY_SECRET=llm-credentials
LLM_API_KEY_SECRET_KEY=api-key

# Business rule the evaluation labels follow (USD per customer request). The three policy
# versions themselves are fixed in agent/src/support_agent/policy.py, one Deployment each.
REFUND_LIMIT=500

# Evaluation load: every policy gets the same cases, rounds and concurrency.
# LOAD_ROUNDS=1
# EVAL_WORKERS=4

# Optional: no LLM at all (deterministic scripted agents; the evaluation skips the judge).
# LLM_PROVIDER=scripted

# Optional overrides (defaults work on OpenShift AI 3.x with MLflow enabled):
# MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc:8443/mlflow
# MLFLOW_PUBLIC_URI=https://rh-ai.apps.<cluster-domain>/mlflow     # derived from the data science gateway
# TRACE_EXPERIMENT=uc3-rhoai-policy-validation
# EVAL_EXPERIMENT=uc3-rhoai-policy-validation-eval
# NOT_GRANTED_EXPERIMENT=uc3-rhoai-not-granted
# PROMETHEUS_URL=https://data-science-prometheus-route-redhat-ods-monitoring.apps.<cluster-domain>
# CLUSTER_PROMETHEUS_URL=https://thanos-querier-openshift-monitoring.apps.<cluster-domain>
