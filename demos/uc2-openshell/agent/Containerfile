# Support agent (LangGraph + NeMo Relay), UC2, packaged as an OpenShell sandbox image.
# Build context: demos/uc2-openshell (so the Relay and OpenShell policy files are included).
#
# OpenShell requirements for a bring-your-own-container image:
#   * a standard Linux base image (no distroless / scratch),
#   * a non-root USER,
#   * /sandbox (or WORKDIR) as the writable workspace.
# The image needs no OpenShell packages. OpenShell replaces CMD/ENTRYPOINT with
# its sandbox supervisor, so the start command is passed to
# `openshell sandbox create ... -- <command>` (see the Makefile).
FROM docker.io/library/python:3.12-slim

# PYTHONDONTWRITEBYTECODE: site-packages is read-only inside the sandbox
# (Landlock), so Python must not try to write .pyc files there.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MLFLOW_DISABLE_AGENT_HINT=1 \
    RELAY_TELEMETRY_DIR=/sandbox/telemetry

WORKDIR /app
COPY agent/pyproject.toml agent/pyproject.toml
COPY agent/src agent/src
RUN pip install ./agent && rm -rf /app/agent

# Relay telemetry policy (read-only inside the sandbox).
COPY relay /app/relay

# The OpenShell sandbox policy is passed with `--policy` at creation time. A copy
# also ships at the well-known path so the image is safe by default.
COPY openshell/policy.yaml /etc/openshell/policy.yaml

RUN groupadd --gid 1500 agent \
    && useradd --uid 1500 --gid agent --create-home agent \
    && install -d -o agent -g agent /sandbox /sandbox/telemetry
WORKDIR /sandbox
USER agent

EXPOSE 8000
# Informational only: OpenShell does not run CMD. The Makefile passes the
# equivalent command, bound to loopback, which is where OpenShell port
# forwarding connects.
CMD ["uvicorn", "support_agent.app:app", "--host", "127.0.0.1", "--port", "8000"]
