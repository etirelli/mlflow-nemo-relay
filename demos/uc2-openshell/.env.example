# Copy to .env (gitignored, chmod 600) and fill in. The Makefile reads it.

# --- LLM: any OpenAI-compatible endpoint with tool calling -------------------
# The agents (inside the sandboxes) and the evaluation's LLM judge (on the
# laptop) both use it. `make provider` turns these into an OpenShell provider:
# the sandbox may call only POST <base path>/chat/completions on this host, and
# it never sees the key (the supervisor injects it on the way out).
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=my-model-id
LLM_API_KEY=replace-me
# No LLM at all (deterministic scripted agents; the judge is skipped):
# LLM_PROVIDER=scripted

# --- Refund policy enforced by NeMo Relay (fixed across agent versions) ------
POLICY_VERSION=v1
REFUND_LIMIT=500

# --- Credentials (demo only) -------------------------------------------------
MLFLOW_ADMIN_PASSWORD=mlflow-admin-demo-password
MLFLOW_SECRET_KEY=uc2-demo-secret-key-change-me
AGENT_MLFLOW_USERNAME=relay-agent
AGENT_MLFLOW_PASSWORD=relay-agent-demo-password

# --- Ports -------------------------------------------------------------------
MLFLOW_PORT=5000
PAYMENTS_PORT=8090
V1_AGENT_PORT=8000
V2_AGENT_PORT=8001

# --- OpenShell ---------------------------------------------------------------
# Container engine of the OpenShell gateway (docker | podman). Auto-detected.
# ENGINE=podman
