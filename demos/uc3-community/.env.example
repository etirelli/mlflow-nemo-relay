# Copy to .env (gitignored) and fill in. compose.yaml and the Makefile read it.

# --- LLM: any OpenAI-compatible endpoint with tool calling -------------------
# The agents and the evaluation's LLM judge both use it.
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=my-model-id
LLM_API_KEY=replace-me
# No LLM at all (deterministic scripted agents; the judge is skipped):
# LLM_PROVIDER=scripted

# --- Refund policy ------------------------------------------------------------
# The policy VERSIONS (v1, v2, v3) are fixed in agent/src/support_agent/policy.py,
# one compose service each. REFUND_LIMIT is the business rule the evaluation
# labels follow: up to $500 per customer request.
REFUND_LIMIT=500

# --- Credentials (demo only) -------------------------------------------------
MLFLOW_ADMIN_PASSWORD=mlflow-admin-demo-password
MLFLOW_SECRET_KEY=uc3-demo-secret-key-change-me
AGENT_MLFLOW_USERNAME=relay-agent
AGENT_MLFLOW_PASSWORD=relay-agent-demo-password

# --- Ports -------------------------------------------------------------------
MLFLOW_PORT=5000
POLICY_V1_PORT=8000
POLICY_V2_PORT=8001
POLICY_V3_PORT=8002
PROMETHEUS_PORT=9090

# --- Evaluation load ------------------------------------------------------------
# Every policy gets the same cases, rounds and concurrency (equivalent load).
LOAD_ROUNDS=1
EVAL_WORKERS=4
