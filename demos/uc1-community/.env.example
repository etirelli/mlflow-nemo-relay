# Copy to .env and adjust. Every value has a working default in compose.yaml.

# --- LLM (any OpenAI-compatible endpoint) -----------------------------------
# Default: Ollama running natively on the host (recommended on macOS).
LLM_PROVIDER=openai
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=not-needed

# Ollama inside compose (`make up-ollama`):
# LLM_BASE_URL=http://ollama:11434/v1

# NVIDIA hosted endpoints (build.nvidia.com):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct
# LLM_API_KEY=nvapi-...

# vLLM / any OpenAI-compatible server:
# LLM_BASE_URL=http://my-vllm:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# No LLM at all (deterministic scripted model, for rehearsals/CI):
# LLM_PROVIDER=scripted

# --- Credentials (demo only, change for shared environments) ----------------
MLFLOW_ADMIN_PASSWORD=mlflow-admin-demo-password
MLFLOW_SECRET_KEY=uc1-demo-secret-key-change-me
AGENT_MLFLOW_USERNAME=relay-agent
AGENT_MLFLOW_PASSWORD=relay-agent-demo-password

# --- Ports / behavior ------------------------------------------------------
MLFLOW_PORT=5000
REDACTED_AGENT_PORT=8000
BASELINE_AGENT_PORT=8001
TOOL_TIMEOUT_SECONDS=2.0
