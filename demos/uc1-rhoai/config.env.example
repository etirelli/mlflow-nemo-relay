# Local, cluster-specific configuration for the UC1 OpenShift AI demo.
# Copy to config.env (gitignored) and edit. Values become OpenShift Template parameters.
#   cp config.env.example config.env

# Namespace (project) for the demo. It is also the MLflow workspace.
NAMESPACE=uc1-rhoai

# LLM: any OpenAI-compatible endpoint that supports tool calling.
# LLM_MODEL must match an id from GET $LLM_BASE_URL/models.
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=my-model-id

# Name of an existing Secret in NAMESPACE that holds the API key, and the key inside it.
# Create it yourself (the key never goes in this file):
#   read -rs "K?API key: "; oc create secret generic llm-credentials -n $NAMESPACE --from-literal=api-key="$K"; unset K
LLM_API_KEY_SECRET=llm-credentials
LLM_API_KEY_SECRET_KEY=api-key

# Optional: no LLM at all (deterministic scripted model, for rehearsals).
# LLM_PROVIDER=scripted

# Optional overrides (defaults work on OpenShift AI 3.x with MLflow enabled):
# MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc:8443/mlflow
# MLFLOW_PUBLIC_URI=https://rh-ai.apps.<cluster-domain>/mlflow     # derived from the data science gateway
# REDACTED_EXPERIMENT=uc1-rhoai-redacted
# BASELINE_EXPERIMENT=uc1-rhoai-baseline
# NOT_GRANTED_EXPERIMENT=uc1-rhoai-not-granted
