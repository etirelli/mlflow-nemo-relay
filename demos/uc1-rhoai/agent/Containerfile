# Customer lookup agent (LangGraph + NeMo Relay), UC1 on Red Hat OpenShift AI.
# Build context: demos/uc1-rhoai (so the Relay policy files are included).
# Built in-cluster by the BuildConfig in openshift/template.yaml (`make build`).
FROM registry.access.redhat.com/ubi9/python-312:latest

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MLFLOW_DISABLE_AGENT_HINT=1 \
    RELAY_TELEMETRY_DIR=/app/telemetry

USER 0
WORKDIR /app
COPY agent/pyproject.toml agent/pyproject.toml
COPY agent/src agent/src
RUN pip install ./agent && rm -rf /app/agent
COPY relay /app/relay
# OpenShift runs the container with an arbitrary UID in group 0.
RUN mkdir -p /app/telemetry && chgrp -R 0 /app && chmod -R g=u /app
USER 1001

EXPOSE 8000
CMD ["uvicorn", "customer_lookup_agent.app:app", "--host", "0.0.0.0", "--port", "8000"]
